{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://christlink-api-staging.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "development",
      "ios": {
        "image": "latest"
      },
      "android": {
        "image": "latest"
      },
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://christlink-api-staging.up.railway.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "node": "22.14.0"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "channel": "production",
      "node": "22.14.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
