{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://christlink-api-staging.up.railway.app"
      },
      "channel": "development",
      "ios": {
        "image": "default"
      },
      "android": {
        "image": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "default"
      },
      "ios": {
        "simulator": false,
        "image": "default"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://christlink-api-staging.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "aab",
        "image": "default"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "default"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
