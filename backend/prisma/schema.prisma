  profiles_blocks_blocked_idToprofiles profiles @relation("blocks_blocked_idToprofiles", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_blocks_blocker_idToprofiles profiles @relation("blocks_blocker_idToprofiles", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blocker_id, blocked_id])
