/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model church_claims {
  id                                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  church_id                                   String    @db.Uuid
  user_id                                     String    @db.Uuid
  role_at_church                              String?
  note                                        String?
  status                                      String    @default("pending")
  decided_by                                  String?   @db.Uuid
  decided_at                                  DateTime? @db.Timestamptz(6)
  created_at                                  DateTime  @default(now()) @db.Timestamptz(6)
  churches                                    churches  @relation(fields: [church_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_church_claims_decided_byToprofiles profiles? @relation("church_claims_decided_byToprofiles", fields: [decided_by], references: [id], onUpdate: NoAction)
  profiles_church_claims_user_idToprofiles    profiles  @relation("church_claims_user_idToprofiles", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([church_id, user_id])
