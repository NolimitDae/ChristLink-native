{
  "name": "christlink-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7",
    "bullmq": "^5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "8.1.0",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.2",
    "node-forge": "^1.4.0",
    "prisma": "^7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "^15.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.6",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.0.17",
    "@types/express": "5.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.14.1",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "supertest": "^7.3.1",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
