    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "8.1.0",
    "ioredis": "^5.6.1",
    "prisma": "^7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.6",
    "@nestjs/schematics": "11.0.5",
    "@nestjs/testing": "11.0.17",
    "@types/express": "5.0.1",
