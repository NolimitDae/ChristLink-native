# Copy to .env for local dev. Real values live in Railway variables, never in the repo.
APP_NAME=ChristLink
PORT=4000
# api (default) or worker. Both Railway services run `node dist/src/main`; the worker service sets ROLE=worker.
ROLE=api

# Local docker compose (docker compose up -d): Postgres on 5433, Redis on 6380
DATABASE_URL=postgresql://christlink:christlink@localhost:5433/christlink
REDIS_URL=redis://localhost:6380
# Only for `prisma migrate diff --from-migrations` locally
SHADOW_DATABASE_URL=postgresql://christlink:christlink@localhost:5433/christlink_shadow

# Long random string (openssl rand -hex 32). Signs HS256 access tokens.
JWT_SECRET=replace-with-64-random-hex-chars

# Website allowed to call the API; extra ones comma-separated in CORS_ORIGINS
CLIENT_APP_URL=https://christlinksocial.com
CORS_ORIGINS=https://www.christlinksocial.com
APP_URL=https://christlinksocial.com

# Email codes. Without RESEND_API_KEY the code is written to the log (local dev only).
RESEND_API_KEY=
FROM_EMAIL=Christ Link Social <hello@christlinksocial.com>
# Fixed code for the App Store / Play reviewer account
REVIEW_EMAIL=
REVIEW_CODE=

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=christlink
R2_PUBLIC_URL=https://files.christlinksocial.com

# Optional: enables Expo enhanced push security
EXPO_ACCESS_TOKEN=

# Apple Wallet passes
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.christlinksocial.ticket
APPLE_PASS_P12_BASE64=
APPLE_PASS_PASSWORD=

SENTRY_DSN=
