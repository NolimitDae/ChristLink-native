{
  "expo": {
    "name": "Christ Link Social",
    "slug": "christlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "christlink",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.christlink.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Christ Link Social uses the camera to scan tickets and volunteer passes at check-in, and to take event or profile photos.",
        "NSPhotoLibraryUsageDescription": "Christ Link Social uses your photo library so you can choose a profile picture, banner or event cover.",
        "NSLocationWhenInUseUsageDescription": "Christ Link Social uses your location to show events and churches near you. It is never shared with other people.",
        "NSUserNotificationUsageDescription": "Christ Link Social sends ticket confirmations, event reminders and prayer updates.",
        "NSPhotoLibraryAddUsageDescription": "Christ Link Social saves share cards to your photo library when you ask it to.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:christlinksocial.com",
        "applinks:www.christlinksocial.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0C0A"
      },
      "package": "com.christlink.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "christlinksocial.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "christlinksocial.com",
              "pathPrefix": "/church"
            },
            {
              "scheme": "https",
              "host": "www.christlinksocial.com",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.christlinksocial.com",
              "pathPrefix": "/church"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A84C",
          "sounds": []
        }
      ],
      "@sentry/react-native/expo",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Christ Link Social uses your location to show events and churches near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Christ Link Social uses your photos so you can choose a profile picture, banner or event cover.",
          "cameraPermission": "Christ Link Social uses the camera to take event or profile photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Christ Link Social uses the camera to scan tickets and volunteer passes at check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.christlinksocial.app",
          "enableGooglePay": true
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E0C0A",
          "imageWidth": 200
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
