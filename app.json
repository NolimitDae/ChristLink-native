{
  "expo": {
    "name": "ChristLink",
    "slug": "christlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "christlink",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.christlink.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ChristLink uses your camera to capture event and profile photos.",
        "NSPhotoLibraryUsageDescription": "ChristLink accesses your photo library to set event covers and profile pictures.",
        "NSLocationWhenInUseUsageDescription": "ChristLink uses your location to find faith events near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.christlink.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ChristLink to use your location to find events near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set a profile picture and event cover."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A84C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
