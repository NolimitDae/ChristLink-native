# Christ Link Social — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe (publishable key — safe to be in client bundle)
# Use a pk_test_ key until launch (Phase 5). Live keys charge real cards.
EXPO_PUBLIC_STRIPE_PK=pk_test_your_stripe_key
# Apple Pay merchant ID registered in your Apple Developer account
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.christlinksocial.app

# Backend API
EXPO_PUBLIC_API_BASE=https://your-api.railway.app

# Sentry (optional — error monitoring)
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project

# Android Google Maps SDK key (build-time only, read by app.config.js)
GOOGLE_MAPS_API_KEY=

# EAS (set in eas.json / CI secrets, not here)
# EAS_PROJECT_ID=your-eas-project-id
